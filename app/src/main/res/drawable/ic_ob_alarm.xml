<?xml version="1.0" encoding="utf-8"?>
<!-- Phone with alarm sound waves — Intruder page illustration (white on transparent) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Sound waves RIGHT side (3 arcs, centered at phone center 60,54) -->
    <!-- r=40: from (86,23) to (86,85) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 86,23 A 40,40 0 0 1 86,85"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- r=50: from (92,16) to (92,92) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 92,16 A 50,50 0 0 1 92,92"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeAlpha="0.7" />

    <!-- r=60: from (99,8) to (99,100) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 99,8 A 60,60 0 0 1 99,100"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.4" />

    <!-- Sound waves LEFT side (mirror) -->
    <!-- r=40: from (34,23) to (34,85) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 34,23 A 40,40 0 0 0 34,85"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- r=50 left -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 28,16 A 50,50 0 0 0 28,92"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeAlpha="0.7" />

    <!-- r=60 left -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 21,8 A 60,60 0 0 0 21,100"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.4" />

    <!-- Phone body (on top of waves) -->
    <path
        android:fillColor="#50FFFFFF"
        android:pathData="M 41,10 L 79,10 A 6,6 0 0 1 85,16 L 85,92 A 6,6 0 0 1 79,98 L 41,98 A 6,6 0 0 1 35,92 L 35,16 A 6,6 0 0 1 41,10 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />

    <!-- Screen (red/alarming tint) -->
    <path
        android:fillColor="#40FFFFFF"
        android:pathData="M 39,20 L 81,20 L 81,82 L 39,82 Z" />

    <!-- Exclamation mark on screen — vertical bar -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 60,32 L 60,60"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Exclamation mark dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 60,68 A 4,4 0 1 0 60.001,68 Z" />

</vector>
