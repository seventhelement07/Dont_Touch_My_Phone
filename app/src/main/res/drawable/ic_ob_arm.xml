<?xml version="1.0" encoding="utf-8"?>
<!-- Phone face-down with countdown clock — Arm page illustration (white on transparent) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Phone body -->
    <path
        android:fillColor="#40FFFFFF"
        android:pathData="M 41,10 L 79,10 A 6,6 0 0 1 85,16 L 85,92 A 6,6 0 0 1 79,98 L 41,98 A 6,6 0 0 1 35,92 L 35,16 A 6,6 0 0 1 41,10 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />

    <!-- Screen -->
    <path
        android:fillColor="#20FFFFFF"
        android:pathData="M 39,20 L 81,20 L 81,82 L 39,82 Z" />

    <!-- Down arrow stem -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 60,28 L 60,60"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Down arrow head -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 48,52 L 60,68 L 72,52 Z" />

    <!-- Clock face circle -->
    <path
        android:fillColor="#30FFFFFF"
        android:pathData="M 88,56 A 18,18 0 1 0 88.001,56 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5" />

    <!-- Clock center dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 106,56 A 2.5,2.5 0 1 0 106.001,56 Z" />

    <!-- Hour hand pointing to 12 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 106,56 L 106,42"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- Minute hand at ~10 seconds (pointing to 2 o'clock) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 106,56 L 116,49"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

</vector>
